# Multi-Domain Sales & Commerce Platform - Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
PLATFORM_NAME="Multi-Domain Sales & Commerce Platform"
DEFAULT_CURRENCY=ETB

# API Service
API_PORT=4000
API_URL=http://localhost:4000

# Web Application
WEB_PORT=3000
WEB_URL=http://localhost:3000

# PostgreSQL 18
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=platform_secure_password
POSTGRES_DB=platform_core
DATABASE_URL=postgresql://platform_admin:platform_secure_password@localhost:5432/platform_core?sslmode=disable

# Redis 7+
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password
S3_BUCKET_NAME=platform-media
S3_REGION=us-east-1

# Identity & Security
JWT_SECRET=dev_jwt_secret_change_in_production_super_secure_32chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev_session_secret_change_in_production_32chars
COOKIE_SECRET=dev_cookie_secret_change_in_production_32chars

# Logging & Telemetry
LOG_LEVEL=debug
